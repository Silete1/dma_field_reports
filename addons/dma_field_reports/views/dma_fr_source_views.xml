<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dma_fr_source_view_list" model="ir.ui.view">
        <field name="name">dma.fr.source.list</field>
        <field name="model">dma.fr.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mode"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="dump_date"/>
                <field name="refreshed_on"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="dma_fr_source_view_form" model="ir.ui.view">
        <field name="name">dma.fr.source.form</field>
        <field name="model">dma.fr.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh" type="object" string="Load IMSMA data" class="btn-primary"/>
                    <button name="action_test_connection" type="object" string="Test connection" invisible="mode != 'live'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. IMSMA backup 2025-03-02"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="not last_error"><field name="last_error" nolabel="1"/></div>
                    <group>
                        <group>
                            <field name="mode" widget="radio"/>
                            <field name="is_current"/>
                        </group>
                        <group>
                            <field name="dump_date"/>
                            <field name="refreshed_on"/>
                            <field name="refreshed_by"/>
                        </group>
                    </group>
                    <group string="Backup package" invisible="mode != 'package'">
                        <div colspan="2" class="text-muted">
                            Build the package from an IMSMA backup on any PC with Python:
                            <code>python imsma_ref_extract.py --backup Backup_..\Dump.sql --out imsma_ref.zip</code>
                            (the tool is in the module's <code>tools</code> folder). It holds lists only, no report contents.
                        </div>
                        <field name="package_file" filename="package_filename"/>
                        <field name="package_filename" invisible="1"/>
                        <field name="server_path"/>
                    </group>
                    <group string="Live IMSMA database (read-only)" invisible="mode != 'live'">
                        <div colspan="2" class="text-muted">
                            Use a PostgreSQL user that can only read. Odoo opens a read-only transaction and only runs
                            SELECT queries on the lists it needs.
                        </div>
                        <field name="db_host"/>
                        <field name="db_port"/>
                        <field name="db_name"/>
                        <field name="db_user"/>
                        <field name="db_password" password="True"/>
                        <field name="auto_refresh"/>
                    </group>
                    <group string="IMSMA schema (optional)">
                        <field name="xsd_file" filename="xsd_filename"/>
                        <field name="xsd_filename" invisible="1"/>
                    </group>
                    <group string="Last load" invisible="not stats">
                        <field name="stats" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dma_fr_source_action" model="ir.actions.act_window">
        <field name="name">IMSMA data source</field>
        <field name="res_model">dma.fr.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect IMSMA data</p>
            <p>Either upload a package built from an IMSMA backup, or give a read-only connection to the
               IMSMA database. Checking and export use this data; Odoo never writes to IMSMA.</p>
        </field>
    </record>

</odoo>
