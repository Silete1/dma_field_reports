<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The "Fix problems" screen: grouped by severity and column; fix in the line or with the wrench. -->
    <record id="dma_fr_cell_view_problem_list" model="ir.ui.view">
        <field name="name">dma.fr.cell.problem.list</field>
        <field name="model">dma.fr.cell</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0" decoration-danger="state == 'error'"
                  decoration-warning="state == 'warning'" default_order="severity desc, sequence, excel_row">
                <field name="excel_row" readonly="1"/>
                <field name="column" readonly="1" optional="show"/>
                <field name="field_id" readonly="1"/>
                <field name="raw" readonly="1"/>
                <field name="message" readonly="1"/>
                <field name="suggestion" readonly="1" string="Closest matches" optional="show"/>
                <field name="override" placeholder="type the right value"/>
                <field name="state" column_invisible="1"/>
                <field name="sequence" column_invisible="1"/>
                <button name="action_fix" type="object" string="Fix" icon="fa-wrench" class="btn-link"/>
                <button name="action_accept" type="object" string="Accept" icon="fa-check" class="btn-link"
                        invisible="state != 'warning'" title="Keep the value as it is"/>
            </list>
        </field>
    </record>

    <record id="dma_fr_cell_view_search" model="ir.ui.view">
        <field name="name">dma.fr.cell.search</field>
        <field name="model">dma.fr.cell</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_id"/>
                <field name="raw"/>
                <field name="message"/>
                <filter name="errors" string="Must fix" domain="[('state', '=', 'error')]"/>
                <filter name="warnings" string="To check" domain="[('state', '=', 'warning')]"/>
                <separator/>
                <group>
                    <filter name="by_field" string="Column" context="{'group_by': 'field_id'}"/>
                    <filter name="by_raw" string="Value in the file" context="{'group_by': 'raw'}"/>
                    <filter name="by_row" string="Row" context="{'group_by': 'row_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dma_fr_cell_view_form" model="ir.ui.view">
        <field name="name">dma.fr.cell.form</field>
        <field name="model">dma.fr.cell</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fix" type="object" string="Fix" class="btn-primary"
                            invisible="state not in ('error', 'warning')"/>
                    <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="row_id" readonly="1"/>
                            <field name="field_id" readonly="1"/>
                            <field name="column" readonly="1"/>
                        </group>
                        <group>
                            <field name="raw" readonly="1"/>
                            <field name="override"/>
                            <field name="sent_value" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                        <field name="suggestion" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
